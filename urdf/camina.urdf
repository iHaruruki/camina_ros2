<?xml version="1.0"?>
<robot name="cibo" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Color -->
  <material name="black">
    <color rgba="0.0 0.0 0.0 1"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>

  <material name="blue">
      <color rgba="0 0 0.5 1"/>
  </material>

  <material name="green">
      <color rgba="0 0.5 0 1"/>
  </material>

  <material name="orange">
      <color rgba="1 0.64 0 1"/>
  </material>

  <!-- base frame -->
  <link name="base_link"/>

  <!-- front_camera -->
  <link name="camera_front_link">
    <visual>
      <geometry>
        <box size="0.05 0.1 0.03"/>
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <joint name="camera_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_front_link"/>
    <origin xyz="0.0 0.0 0.9" rpy="0 0 0"/>
  </joint>

  <!-- camera_front_color_frame  -->
  <link name="camera_front_color_frame"/>

  <joint name="camera_front_color_joint" type="fixed">
    <parent link="camera_front_link"/>
    <child link="camera_front_color_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- camera_front_color_optical_frame  -->
  <link name="camera_front_color_optical_frame"/>

  <joint name="camera_front_color_optical_joint" type="fixed">
    <parent link="camera_front_color_frame"/>
    <child link="camera_front_color_optical_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- camera_front_depth_frame  -->
  <link name="camera_front_depth_frame"/>

  <joint name="camera_front_depth_joint" type="fixed">
    <parent link="camera_front_link"/>
    <child link="camera_front_depth_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- camera_front_depth_optical_frame  -->
  <link name="camera_front_depth_optical_frame"/>

  <joint name="camera_front_depth_optical_joint" type="fixed">
    <parent link="camera_front_depth_frame"/>
    <child link="camera_front_depth_optical_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- rear_camera -->
  <link name="camera_rear_link">
    <visual>
      <geometry>
        <box size="0.05 0.1 0.03"/>
      </geometry>
      <material name="black" />
    </visual>
  </link>

  <joint name="camera_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_rear_link"/>
    <origin xyz="3.8 0.0 0.9" rpy="0 0 3.14"/>
  </joint>

  <!-- camera_rear_color_frame  -->
  <link name="camera_rear_color_frame"/>

  <joint name="camera_rear_color_joint" type="fixed">
    <parent link="camera_rear_link"/>
    <child link="camera_rear_color_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- camera_rear_color_optical_frame  -->
  <link name="camera_rear_color_optical_frame"/>

  <joint name="camera_rear_color_optical_joint" type="fixed">
    <parent link="camera_rear_color_frame"/>
    <child link="camera_rear_color_optical_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- Optical frame -->
  <link name="camera_rear_depth_optical_frame"/>

  <joint name="camera_rear_optical_joint" type="fixed">
    <parent link="camera_rear_link"/>
    <child link="camera_rear_depth_optical_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- LiDAR -->
  <link name="laser">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.1"/>
      </geometry>
      <material name="orange" />
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser"/>
      <origin xyz="0.1 0 0.4" rpy="0 0 0"/>
  </joint>

</robot>